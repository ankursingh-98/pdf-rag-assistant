# Server
PORT=3001
NODE_ENV=development

# Ollama (Phase 6+)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Qdrant (Phase 7+)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=pdf_chunks

# Chunking (Phase 5+)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Uploads (Phase 3+)
UPLOAD_DIR=./tmp/uploads
MAX_FILE_SIZE_MB=20
